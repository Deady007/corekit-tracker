# SMTP credentials for Trivyah Task Manager (password resets, invites, notifications).
#
# On the server, copy this to /etc/corekit.env (root-owned, referenced by
# deploy/corekit.service's EnvironmentFile= — NOT inside the repo, never in git)
# and fill in real values, then:
#   systemctl restart corekit
#
# For local dev, copy it to data/smtp.env in this repo instead (data/ and
# *.env are already gitignored) and source it before `node server.js`.

COREKIT_SMTP_HOST=smtp.gmail.com
COREKIT_SMTP_PORT=465
COREKIT_SMTP_USER=your-account@gmail.com
COREKIT_SMTP_PASS=your-16-char-app-password
COREKIT_SMTP_FROM=your-account@gmail.com
COREKIT_PUBLIC_URL=https://corekit.me
